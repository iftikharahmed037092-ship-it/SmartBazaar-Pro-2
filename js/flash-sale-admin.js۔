/*==================================================
CLEAR EDITOR
==================================================*/

function clearEditor() {

    const form =
        getElement(
            "#flashSaleForm",
            ".flash-sale-form"
        );


    if (
        form &&
        typeof form.reset === "function"
    ) {

        form.reset();

    }


    const productName =
        getElement(
            "#flashSaleProductName",
            "#flashSaleEditProductName"
        );


    const productId =
        getElement(
            "#flashSaleProductId",
            "#flashSaleEditProductId"
        );


    if (productName) {

        productName.value = "";

    }


    if (productId) {

        productId.value = "";

    }

}


/*==================================================
PREVIEW
==================================================*/

function updatePreview(product = null) {

    let previewProduct =
        product;


    if (!previewProduct) {

        if (selectedProducts.size) {

            const firstId =
                Array.from(
                    selectedProducts
                )[0];


            previewProduct =
                allProducts.find(
                    item =>
                        item.productId === firstId
                );

        }

    }


    if (!previewProduct) {

        previewProduct =
            allProducts.find(
                item =>
                    item.status === "active"
            );

    }


    if (!previewProduct) {
        return;
    }


    const image =
        getProductImage(
            previewProduct
        );


    const name =
        getProductName(
            previewProduct
        );


    const price =
        getProductPrice(
            previewProduct
        );


    const oldPrice =
        getProductOldPrice(
            previewProduct
        );


    const imageElement =
        getElement(
            "#flashSalePreviewImage",
            ".flash-sale-preview-product-image img"
        );


    const nameElement =
        getElement(
            "#flashSalePreviewName",
            ".flash-sale-preview-product-info strong"
        );


    const priceElement =
        getElement(
            "#flashSalePreviewPrice",
            ".flash-sale-preview-price"
        );


    const discountElement =
        getElement(
            "#flashSalePreviewDiscount",
            ".flash-sale-preview-discount"
        );


    if (
        imageElement &&
        image
    ) {

        imageElement.src =
            image;

        imageElement.alt =
            name;

    }


    if (nameElement) {

        nameElement.textContent =
            name;

    }


    if (priceElement) {

        const discount =
            calculateDiscount(
                price,
                oldPrice
            );


        priceElement.innerHTML =
            `
                ${formatPrice(price)}

                ${
                    oldPrice > price
                        ? `
                            <del>
                                ${formatPrice(oldPrice)}
                            </del>
                        `
                        : ""
                }
            `;

    }


    if (discountElement) {

        const discount =
            calculateDiscount(
                price,
                oldPrice
            );


        discountElement.textContent =
            discount > 0
                ? `${discount}% OFF`
                : "FLASH SALE";

    }


    updatePreviewStock(
        previewProduct
    );

}


/*==================================================
CALCULATE DISCOUNT
==================================================*/

function calculateDiscount(
    salePrice,
    oldPrice
) {

    const sale =
        Number(salePrice) || 0;


    const old =
        Number(oldPrice) || 0;


    if (
        old <= 0 ||
        sale <= 0 ||
        sale >= old
    ) {

        return 0;

    }


    return Math.round(
        ((old - sale) / old) * 100
    );

}


/*==================================================
PREVIEW STOCK
==================================================*/

function updatePreviewStock(product) {

    const stock =
        Number(
            product?.stock
        ) || 0;


    const stockText =
        getElement(
            "#flashSalePreviewStockText",
            ".flash-sale-stock-header strong"
        );


    const stockFill =
        getElement(
            "#flashSalePreviewStockFill",
            ".flash-sale-stock-fill"
        );


    if (stockText) {

        stockText.textContent =
            `${formatNumber(stock)} available`;

    }


    if (stockFill) {

        const percentage =
            Math.min(
                100,
                Math.max(
                    0,
                    stock
                )
            );


        stockFill.style.width =
            `${percentage}%`;

    }

}


/*==================================================
ERROR
==================================================*/

function showFlashSaleError(
    message
) {

    const container =
        getElement(
            "#flashSaleAdminError",
            ".flash-sale-admin-error"
        );


    if (!container) {

        showFlashSaleToast(
            message,
            "error"
        );

        return;

    }


    container.innerHTML =
        `
            <i class="fa-solid fa-circle-exclamation"></i>
            ${escapeHtml(message)}
        `;


    container.hidden = false;

}


/*==================================================
ADMIN AUTH
==================================================*/

function verifyAdmin(user) {

    if (!user) {

        isAdmin = false;

        return false;

    }


    const email =
        String(
            user.email || ""
        )
        .trim()
        .toLowerCase();


    isAdmin =
        email ===
        ADMIN_EMAIL.toLowerCase();


    return isAdmin;

}


/*==================================================
AUTH INITIALIZATION
==================================================*/

function initializeAuth() {

    onAuthStateChanged(
        auth,
        user => {

            if (!user) {

                isAdmin = false;

                return;

            }


            if (!verifyAdmin(user)) {

                isAdmin = false;

                console.warn(
                    "Flash Sale Admin: user is not authorized."
                );

                return;

            }


            isAdmin = true;

            initializeFlashSaleAdmin();

        }
    );

}


/*==================================================
INITIALIZATION
==================================================*/

let initialized = false;


function initializeFlashSaleAdmin() {

    if (initialized) {
        return;
    }


    initialized = true;


    setupSearch();

    setupFilters();

    setupSelectionButtons();

    setupModal();

    setupSaveButton();

    setupNewSaleButton();

    loadProducts();

}


/*==================================================
AUTO INITIALIZATION
==================================================*/

if (
    document.readyState ===
    "loading"
) {

    document.addEventListener(
        "DOMContentLoaded",
        initializeAuth
    );

} else {

    initializeAuth();

}


